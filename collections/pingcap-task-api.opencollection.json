          "http": {
            "method": "DELETE",
            "url": "https://you.domain.com/api/v1/tasks/:task-name",
            "params": [
              {
                "name": "task-name",
                "value": "",
                "type": "path",
                "description": "globally unique task name"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "force stop task even if some subtask is running"
              },
              {
                "name": "keep_meta",
                "value": "",
                "type": "query",
                "description": "Whether to keep downstream checkpoints and resumable internal metadata when deleting the task.\nOptimistic shard DDL metadata is always removed.\nWith force=true, only already-persisted checkpoint state is retained; deletion does not flush the latest checkpoint.\nStop the task and wait for the stop operation to complete before deleting it when the latest checkpoint must be retained.\nOnly use keep_meta=true after all DM masters are upgraded, because older versions ignore unknown query parameters."
              }
            ]
          },
          "docs": "delete a task"
